{
  "name": "edge-status",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A zero-dependency status page and health-check API for Cloudflare Workers.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
