  "homepage": "https://github.com/hjddl/edge-status#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjddl/edge-status.git"
  },
  "bugs": {
    "url": "https://github.com/hjddl/edge-status/issues"
  },
  "author": "hjddl",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^4.165.0"
  }
}
